@* "Keep screen on" toggle for the map toolbar (Screen Wake Lock API, js/wakelock.js).
   Browser-only: it changes no data, so nothing is saved or audited. The lock is released when the
   component goes away (leaving the map page). *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<button class="btn @(_state.Held ? "primary" : null)"
        aria-pressed="@(_state.Wanted && Usable ? "true" : "false")"
        disabled="@(!Usable || _busy)"
        title="@Tooltip"
        @onclick="ToggleAsync">
    Keep screen on
</button>

@code {
    private const string Purpose = "Keeps this display awake while the map is open";

    private IJSObjectReference? _module;
    private IJSObjectReference? _controller;
    private DotNetObjectReference<KeepScreenOn>? _self;
    private WakeLockState _state = new(false, "Checking whether this browser can keep the screen on…", false, false);
    private bool _busy;
    private bool _disposed;

    // Disabled when the API is missing, or when a wanted lock was refused (the reason is in the tooltip).
    private bool Usable => _state.Supported && !(_state.Wanted && !_state.Held && _state.Reason is not null);

    private string Tooltip => _state.Reason is { } reason
        ? $"{Purpose}. {reason}"
        : _state.Held ? $"{Purpose}. On: click to turn off." : $"{Purpose}.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./" + Assets["js/wakelock.js"]);
            _self = DotNetObjectReference.Create(this);
            _controller = await _module.InvokeAsync<IJSObjectReference>("create", _self);
            _state = await _controller.InvokeAsync<WakeLockState>("start");
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (JSException ex)
        {
            // Never let this break the map.
            _state = new WakeLockState(false, "Couldn't start: " + ex.Message, false, false);
        }

        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        if (_controller is null)
        {
            return;
        }

        _busy = true;
        try
        {
            _state = await _controller.InvokeAsync<WakeLockState>("setWanted", !_state.Wanted);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException ex)
        {
            _state = _state with { Reason = "Couldn't change it: " + ex.Message };
        }
        finally
        {
            _busy = false;
        }
    }

    [JSInvokable]
    public Task OnWakeLockChanged(WakeLockState state)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        _state = state;
        return InvokeAsync(StateHasChanged);
    }

    public sealed record WakeLockState(bool Supported, string? Reason, bool Wanted, bool Held);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_controller is not null)
            {
                await _controller.InvokeVoidAsync("dispose");
                await _controller.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; the browser drops the lock with the page.
        }

        _self?.Dispose();
    }
}
