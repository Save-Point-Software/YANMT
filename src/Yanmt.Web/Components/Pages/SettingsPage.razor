@page "/settings"
@using Yanmt.Core.ConfigBackups
@using Yanmt.Core.Monitoring
@using Yanmt.Core.Retention
@inject SettingsService Settings
@inject AuthenticationStateProvider Auth

<PageTitle>Settings - YANMT</PageTitle>

<div class="page narrow">
    <h1>Settings</h1>

    <section class="card">
        <h2>Status colors</h2>
        <p class="muted">Colors used for node, link and submap states on the map and in lists.</p>

        @if (_colors is not null)
        {
            <div class="color-grid">
                @foreach (var (label, severity) in Rows)
                {
                    <label class="color-row">
                        <StateDot State="severity" Colors="Current" />
                        <span>@label</span>
                        <input type="color" value="@Get(severity)" disabled="@(!_isAdmin)"
                               @onchange="e => Set(severity, (string)e.Value!)" />
                        <code>@Get(severity)</code>
                    </label>
                }
            </div>

            @if (_isAdmin)
            {
                <div class="form-actions">
                    <button class="btn primary" @onclick="SaveAsync" disabled="@(!_dirty)">Save colors</button>
                    <button class="btn" @onclick="ResetDefaults">Reset to defaults</button>
                    @if (_saved)
                    {
                        <span class="success">Saved.</span>
                    }
                </div>
            }
        }
    </section>

    <section class="card">
        <h2>ICMP polling</h2>
        <p class="muted">
            Every enabled node with ICMP on gets a burst of echoes each interval. Loss or latency over a threshold is
            Warning straight away. No reply at all shows Warning first and goes Critical after the set number of
            consecutive failed polls, so one lost burst doesn't flap the map.
        </p>

        <div class="field-row">
            <div class="field narrow-field">
                <label for="icmp-interval">Interval (s)</label>
                <input id="icmp-interval" type="number" @bind="_icmp.IntervalSeconds" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="icmp-count">Echoes per poll</label>
                <input id="icmp-count" type="number" @bind="_icmp.EchoCount" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="icmp-timeout">Timeout per echo (ms)</label>
                <input id="icmp-timeout" type="number" @bind="_icmp.TimeoutMs" disabled="@(!_isAdmin)" />
            </div>
        </div>
        <div class="field-row">
            <div class="field narrow-field">
                <label for="icmp-loss">Warning at loss (%)</label>
                <input id="icmp-loss" type="number" step="any" @bind="_icmp.WarningLossPercent" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="icmp-latency">Warning at average latency (ms)</label>
                <input id="icmp-latency" type="number" step="any" @bind="_icmp.WarningLatencyMs" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="icmp-failures">Failed polls before Critical</label>
                <input id="icmp-failures" type="number" @bind="_icmp.FailuresBeforeCritical" disabled="@(!_isAdmin)" />
            </div>
        </div>

        @foreach (var (_, error) in _icmpErrors)
        {
            <p class="error">@error</p>
        }

        @if (_isAdmin)
        {
            <div class="form-actions">
                <button class="btn primary" @onclick="SaveIcmpAsync">Save ICMP settings</button>
                <button class="btn" @onclick="() => { _icmp = new IcmpForm(new IcmpSettings()); _icmpSaved = false; }">Reset to defaults</button>
                @if (_icmpSaved)
                {
                    <span class="success">Saved. Pollers pick it up within a few seconds.</span>
                }
            </div>
        }
    </section>

    <section class="card">
        <h2>SNMP default stats</h2>
        <p class="muted">
            Polled on every enabled node with SNMP on and an SNMPv3 profile: system info, uptime (reboots show Warning
            until the next poll), CPU (cpmCPUTotal5minRev) and memory (the Processor pool). CPU and memory thresholds
            can be overridden per node on the node's edit page.
        </p>
        <div class="field-row">
            <div class="field narrow-field">
                <label for="snmp-interval">Interval (s)</label>
                <input id="snmp-interval" type="number" @bind="_snmp.IntervalSeconds" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="snmp-timeout">Timeout per request (ms)</label>
                <input id="snmp-timeout" type="number" @bind="_snmp.TimeoutMs" disabled="@(!_isAdmin)" />
            </div>
        </div>
        <div class="field-row">
            <div class="field narrow-field">
                <label for="cpu-warn">CPU Warning (%)</label>
                <input id="cpu-warn" type="number" step="any" @bind="_snmp.CpuWarningPercent" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="cpu-crit">CPU Critical (%)</label>
                <input id="cpu-crit" type="number" step="any" @bind="_snmp.CpuCriticalPercent" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="mem-warn">Memory Warning (%)</label>
                <input id="mem-warn" type="number" step="any" @bind="_snmp.MemoryWarningPercent" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="mem-crit">Memory Critical (%)</label>
                <input id="mem-crit" type="number" step="any" @bind="_snmp.MemoryCriticalPercent" disabled="@(!_isAdmin)" />
            </div>
        </div>

        @foreach (var (_, error) in _snmpErrors)
        {
            <p class="error">@error</p>
        }

        @if (_isAdmin)
        {
            <div class="form-actions">
                <button class="btn primary" @onclick="SaveSnmpAsync">Save SNMP settings</button>
                <button class="btn" @onclick="() => { _snmp = new SnmpForm(new SnmpSettings()); _snmpSaved = false; }">Reset to defaults</button>
                @if (_snmpSaved)
                {
                    <span class="success">Saved. Pollers pick it up within a few seconds.</span>
                }
            </div>
        }
    </section>

    <section class="card">
        <h2>Config backups</h2>
        <p class="muted">
            <code>show running-config</code> is pulled over SSH on this interval and a new version is stored only when
            the normalized text changes. Built-in volatile lines (timestamps, byte counts, clock-period) are always
            ignored; add more below. Rules are global. Use one regular expression per line; any config line matching
            one (anywhere, case-insensitive) is ignored when comparing versions. Stored configs are never altered.
        </p>
        <div class="field-row">
            <div class="field narrow-field">
                <label><input type="checkbox" @bind="_backupEnabled" disabled="@(!_isAdmin)" /> Scheduled backups enabled</label>
            </div>
            <div class="field narrow-field">
                <label for="backup-interval">Interval (s)</label>
                <input id="backup-interval" type="number" @bind="_backupInterval" disabled="@(!_isAdmin)" />
            </div>
        </div>
        <div class="field">
            <label for="backup-patterns">Ignore patterns (one per line)</label>
            <textarea id="backup-patterns" rows="6" @bind="_backupPatterns" disabled="@(!_isAdmin)"
                      placeholder="^! Last configuration change"></textarea>
        </div>

        @foreach (var (_, error) in _backupErrors)
        {
            <p class="error">@error</p>
        }

        @if (_isAdmin)
        {
            <div class="form-actions">
                <button class="btn primary" @onclick="SaveBackupAsync">Save backup settings</button>
                <button class="btn" @onclick="ResetBackup">Reset to defaults</button>
                @if (_backupSaved)
                {
                    <span class="success">Saved. Applies on the next scheduling pass.</span>
                }
            </div>
        }
    </section>

    <section class="card">
        <h2>Data retention</h2>
        <p class="muted">
            A nightly cleanup (about 03:00 UTC) deletes data past these limits, then compacts the database. Raw samples
            are only deleted after they have been rolled up into hourly min/avg/max. Config versions are all kept unless
            a limit is set; the newest version of each node is never deleted.
        </p>
        <div class="field-row">
            <div class="field narrow-field">
                <label for="ret-raw">Raw samples (days)</label>
                <input id="ret-raw" type="number" @bind="_retRaw" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="ret-rollup">Hourly rollups (days)</label>
                <input id="ret-rollup" type="number" @bind="_retRollup" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="ret-events">Events (days)</label>
                <input id="ret-events" type="number" @bind="_retEvents" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="ret-versions">Config versions to keep per node (empty = all)</label>
                <input id="ret-versions" type="number" @bind="_retVersions" disabled="@(!_isAdmin)" />
            </div>
        </div>

        @foreach (var (_, error) in _retErrors)
        {
            <p class="error">@error</p>
        }

        @if (_isAdmin)
        {
            <div class="form-actions">
                <button class="btn primary" @onclick="SaveRetentionAsync">Save retention settings</button>
                <button class="btn" @onclick="() => { LoadRetention(new RetentionSettings()); _retSaved = false; }">Reset to defaults</button>
                @if (_retSaved)
                {
                    <span class="success">Saved. Applies at the next nightly cleanup.</span>
                }
            </div>
        }
    </section>
</div>

@code {
    private static readonly (string Label, Severity Severity)[] Rows =
    [
        ("Normal", Severity.Normal), ("Warning", Severity.Warning),
        ("Critical", Severity.Critical), ("Unknown / no data", Severity.Unknown),
    ];

    private Dictionary<Severity, string>? _colors;
    private bool _isAdmin;
    private bool _dirty;
    private bool _saved;

    private StatusColors Current => new(Get(Severity.Normal), Get(Severity.Warning), Get(Severity.Critical), Get(Severity.Unknown));

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        _isAdmin = state.User.IsInRole(YanmtRoles.Admin);
        Load(await Settings.GetAsync(SettingKeys.StatusColors));
        _icmp = new IcmpForm(await Settings.GetAsync(SettingKeys.Icmp));
        _snmp = new SnmpForm(await Settings.GetAsync(SettingKeys.Snmp));
        LoadBackup(await Settings.GetAsync(SettingKeys.ConfigBackup));
        LoadRetention(await Settings.GetAsync(SettingKeys.Retention));
    }

    private int _retRaw, _retRollup, _retEvents;
    private int? _retVersions;
    private IReadOnlyList<(string Field, string Error)> _retErrors = [];
    private bool _retSaved;

    private void LoadRetention(RetentionSettings s)
    {
        _retRaw = s.RawSampleDays;
        _retRollup = s.RollupDays;
        _retEvents = s.EventDays;
        _retVersions = s.KeepConfigVersions;
    }

    private async Task SaveRetentionAsync()
    {
        _retSaved = false;
        var settings = new RetentionSettings
        {
            RawSampleDays = _retRaw, RollupDays = _retRollup, EventDays = _retEvents, KeepConfigVersions = _retVersions,
        };
        _retErrors = settings.Validate();
        if (!_isAdmin || _retErrors.Count > 0)
        {
            return;
        }

        await Settings.SetAsync(SettingKeys.Retention, settings);
        _retSaved = true;
    }

    private bool _backupEnabled = true;
    private int _backupInterval = 86400;
    private string _backupPatterns = "";
    private IReadOnlyList<(string Field, string Error)> _backupErrors = [];
    private bool _backupSaved;

    private void LoadBackup(ConfigBackupSettings s)
    {
        _backupEnabled = s.Enabled;
        _backupInterval = s.IntervalSeconds;
        _backupPatterns = string.Join('\n', s.NormalizationPatterns);
    }

    private void ResetBackup()
    {
        LoadBackup(new ConfigBackupSettings());
        _backupSaved = false;
    }

    private async Task SaveBackupAsync()
    {
        _backupSaved = false;
        var settings = new ConfigBackupSettings
        {
            Enabled = _backupEnabled,
            IntervalSeconds = _backupInterval,
            NormalizationPatterns = _backupPatterns
                .Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries),
        };
        _backupErrors = settings.Validate();
        if (!_isAdmin || _backupErrors.Count > 0)
        {
            return;
        }

        await Settings.SetAsync(SettingKeys.ConfigBackup, settings);
        _backupSaved = true;
    }

    private SnmpForm _snmp = new(new SnmpSettings());
    private IReadOnlyList<(string Field, string Error)> _snmpErrors = [];
    private bool _snmpSaved;

    private async Task SaveSnmpAsync()
    {
        _snmpSaved = false;
        var settings = _snmp.ToSettings();
        _snmpErrors = settings.Validate();
        if (!_isAdmin || _snmpErrors.Count > 0)
        {
            return;
        }

        await Settings.SetAsync(SettingKeys.Snmp, settings);
        _snmpSaved = true;
    }

    /// <summary>Mutable copy for binding; SnmpSettings itself is immutable.</summary>
    private sealed class SnmpForm(SnmpSettings s)
    {
        public int IntervalSeconds { get; set; } = s.IntervalSeconds;
        public int TimeoutMs { get; set; } = s.TimeoutMs;
        public double CpuWarningPercent { get; set; } = s.CpuWarningPercent;
        public double CpuCriticalPercent { get; set; } = s.CpuCriticalPercent;
        public double MemoryWarningPercent { get; set; } = s.MemoryWarningPercent;
        public double MemoryCriticalPercent { get; set; } = s.MemoryCriticalPercent;

        public SnmpSettings ToSettings() => new()
        {
            IntervalSeconds = IntervalSeconds,
            TimeoutMs = TimeoutMs,
            CpuWarningPercent = CpuWarningPercent,
            CpuCriticalPercent = CpuCriticalPercent,
            MemoryWarningPercent = MemoryWarningPercent,
            MemoryCriticalPercent = MemoryCriticalPercent,
        };
    }

    private IcmpForm _icmp = new(new IcmpSettings());
    private IReadOnlyList<(string Field, string Error)> _icmpErrors = [];
    private bool _icmpSaved;

    private async Task SaveIcmpAsync()
    {
        _icmpSaved = false;
        var settings = _icmp.ToSettings();
        _icmpErrors = settings.Validate();
        if (!_isAdmin || _icmpErrors.Count > 0)
        {
            return;
        }

        await Settings.SetAsync(SettingKeys.Icmp, settings);
        _icmpSaved = true;
    }

    /// <summary>Mutable copy for binding; IcmpSettings itself is immutable.</summary>
    private sealed class IcmpForm(IcmpSettings s)
    {
        public int IntervalSeconds { get; set; } = s.IntervalSeconds;
        public int EchoCount { get; set; } = s.EchoCount;
        public int TimeoutMs { get; set; } = s.TimeoutMs;
        public double WarningLossPercent { get; set; } = s.WarningLossPercent;
        public double WarningLatencyMs { get; set; } = s.WarningLatencyMs;
        public int FailuresBeforeCritical { get; set; } = s.FailuresBeforeCritical;

        public IcmpSettings ToSettings() => new()
        {
            IntervalSeconds = IntervalSeconds,
            EchoCount = EchoCount,
            TimeoutMs = TimeoutMs,
            WarningLossPercent = WarningLossPercent,
            WarningLatencyMs = WarningLatencyMs,
            FailuresBeforeCritical = FailuresBeforeCritical,
        };
    }

    private void Load(StatusColors c) => _colors = new()
    {
        [Severity.Normal] = c.Normal, [Severity.Warning] = c.Warning,
        [Severity.Critical] = c.Critical, [Severity.Unknown] = c.Unknown,
    };

    private string Get(Severity s) => _colors![s];

    private void Set(Severity s, string value)
    {
        _colors![s] = value.ToUpperInvariant();
        _dirty = true;
        _saved = false;
    }

    private void ResetDefaults()
    {
        Load(StatusColors.Default);
        _dirty = true;
        _saved = false;
    }

    private async Task SaveAsync()
    {
        if (!_isAdmin || !Current.IsValid())
        {
            return;
        }

        await Settings.SetAsync(SettingKeys.StatusColors, Current);
        _dirty = false;
        _saved = true;
    }
}
