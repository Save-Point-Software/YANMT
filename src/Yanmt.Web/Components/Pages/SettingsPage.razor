@page "/settings"
@using Yanmt.Core.Monitoring
@inject SettingsService Settings
@inject AuthenticationStateProvider Auth

<PageTitle>Settings - YANMT</PageTitle>

<div class="page narrow">
    <h1>Settings</h1>

    <section class="card">
        <h2>Status colors</h2>
        <p class="muted">Colors used for node, link and submap states on the map and in lists.</p>

        @if (_colors is not null)
        {
            <div class="color-grid">
                @foreach (var (label, severity) in Rows)
                {
                    <label class="color-row">
                        <StateDot State="severity" Colors="Current" />
                        <span>@label</span>
                        <input type="color" value="@Get(severity)" disabled="@(!_isAdmin)"
                               @onchange="e => Set(severity, (string)e.Value!)" />
                        <code>@Get(severity)</code>
                    </label>
                }
            </div>

            @if (_isAdmin)
            {
                <div class="form-actions">
                    <button class="btn primary" @onclick="SaveAsync" disabled="@(!_dirty)">Save colors</button>
                    <button class="btn" @onclick="ResetDefaults">Reset to defaults</button>
                    @if (_saved)
                    {
                        <span class="success">Saved.</span>
                    }
                </div>
            }
        }
    </section>

    <section class="card">
        <h2>ICMP polling</h2>
        <p class="muted">
            Every enabled node with ICMP on gets a burst of echoes each interval. Loss or latency over a threshold is
            Warning straight away. No reply at all shows Warning first and goes Critical after the set number of
            consecutive failed polls, so one lost burst doesn't flap the map.
        </p>

        <div class="field-row">
            <div class="field narrow-field">
                <label for="icmp-interval">Interval (s)</label>
                <input id="icmp-interval" type="number" @bind="_icmp.IntervalSeconds" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="icmp-count">Echoes per poll</label>
                <input id="icmp-count" type="number" @bind="_icmp.EchoCount" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="icmp-timeout">Timeout per echo (ms)</label>
                <input id="icmp-timeout" type="number" @bind="_icmp.TimeoutMs" disabled="@(!_isAdmin)" />
            </div>
        </div>
        <div class="field-row">
            <div class="field narrow-field">
                <label for="icmp-loss">Warning at loss (%)</label>
                <input id="icmp-loss" type="number" step="any" @bind="_icmp.WarningLossPercent" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="icmp-latency">Warning at average latency (ms)</label>
                <input id="icmp-latency" type="number" step="any" @bind="_icmp.WarningLatencyMs" disabled="@(!_isAdmin)" />
            </div>
            <div class="field narrow-field">
                <label for="icmp-failures">Failed polls before Critical</label>
                <input id="icmp-failures" type="number" @bind="_icmp.FailuresBeforeCritical" disabled="@(!_isAdmin)" />
            </div>
        </div>

        @foreach (var (_, error) in _icmpErrors)
        {
            <p class="error">@error</p>
        }

        @if (_isAdmin)
        {
            <div class="form-actions">
                <button class="btn primary" @onclick="SaveIcmpAsync">Save ICMP settings</button>
                <button class="btn" @onclick="() => { _icmp = new IcmpForm(new IcmpSettings()); _icmpSaved = false; }">Reset to defaults</button>
                @if (_icmpSaved)
                {
                    <span class="success">Saved. Pollers pick it up within a few seconds.</span>
                }
            </div>
        }
    </section>

    <p class="muted">SNMP intervals, CPU/memory thresholds and retention settings are added here in later phases.</p>
</div>

@code {
    private static readonly (string Label, Severity Severity)[] Rows =
    [
        ("Normal", Severity.Normal), ("Warning", Severity.Warning),
        ("Critical", Severity.Critical), ("Unknown / no data", Severity.Unknown),
    ];

    private Dictionary<Severity, string>? _colors;
    private bool _isAdmin;
    private bool _dirty;
    private bool _saved;

    private StatusColors Current => new(Get(Severity.Normal), Get(Severity.Warning), Get(Severity.Critical), Get(Severity.Unknown));

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        _isAdmin = state.User.IsInRole(YanmtRoles.Admin);
        Load(await Settings.GetAsync(SettingKeys.StatusColors));
        _icmp = new IcmpForm(await Settings.GetAsync(SettingKeys.Icmp));
    }

    private IcmpForm _icmp = new(new IcmpSettings());
    private IReadOnlyList<(string Field, string Error)> _icmpErrors = [];
    private bool _icmpSaved;

    private async Task SaveIcmpAsync()
    {
        _icmpSaved = false;
        var settings = _icmp.ToSettings();
        _icmpErrors = settings.Validate();
        if (!_isAdmin || _icmpErrors.Count > 0)
        {
            return;
        }

        await Settings.SetAsync(SettingKeys.Icmp, settings);
        _icmpSaved = true;
    }

    /// <summary>Mutable copy for binding; IcmpSettings itself is immutable.</summary>
    private sealed class IcmpForm(IcmpSettings s)
    {
        public int IntervalSeconds { get; set; } = s.IntervalSeconds;
        public int EchoCount { get; set; } = s.EchoCount;
        public int TimeoutMs { get; set; } = s.TimeoutMs;
        public double WarningLossPercent { get; set; } = s.WarningLossPercent;
        public double WarningLatencyMs { get; set; } = s.WarningLatencyMs;
        public int FailuresBeforeCritical { get; set; } = s.FailuresBeforeCritical;

        public IcmpSettings ToSettings() => new()
        {
            IntervalSeconds = IntervalSeconds,
            EchoCount = EchoCount,
            TimeoutMs = TimeoutMs,
            WarningLossPercent = WarningLossPercent,
            WarningLatencyMs = WarningLatencyMs,
            FailuresBeforeCritical = FailuresBeforeCritical,
        };
    }

    private void Load(StatusColors c) => _colors = new()
    {
        [Severity.Normal] = c.Normal, [Severity.Warning] = c.Warning,
        [Severity.Critical] = c.Critical, [Severity.Unknown] = c.Unknown,
    };

    private string Get(Severity s) => _colors![s];

    private void Set(Severity s, string value)
    {
        _colors![s] = value.ToUpperInvariant();
        _dirty = true;
        _saved = false;
    }

    private void ResetDefaults()
    {
        Load(StatusColors.Default);
        _dirty = true;
        _saved = false;
    }

    private async Task SaveAsync()
    {
        if (!_isAdmin || !Current.IsValid())
        {
            return;
        }

        await Settings.SetAsync(SettingKeys.StatusColors, Current);
        _dirty = false;
        _saved = true;
    }
}
