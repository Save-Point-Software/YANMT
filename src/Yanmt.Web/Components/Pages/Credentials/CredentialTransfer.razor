@page "/credentials/transfer"
@attribute [Authorize(Policy = YanmtPolicies.Admin)]
@inject CredentialTransferService Transfer
@inject AuthenticationStateProvider Auth
@inject IJSRuntime Js
@inject TimeProvider Clock

<PageTitle>Export / import credentials - YANMT</PageTitle>

<div class="page">
    <p><a href="credentials">← Credential profiles</a></p>
    <h1>Export / import credentials</h1>
    <p class="muted">
        Stored credentials are bound to this server (DPAPI) and can't be copied to another one. An export re-encrypts the
        profiles with a passphrase (AES-256-GCM, PBKDF2-SHA256) so they can be imported elsewhere. Profiles only; per-node
        settings are not included. The file contains every password: keep it and the passphrase apart, and delete the file
        after importing. Exports and imports are written to the audit log (counts only).
    </p>

    <section class="card">
        <h2>Export</h2>
        <div class="field">
            <label for="exp-pass">Passphrase (at least @PassphraseCrypto.MinPassphraseLength characters)</label>
            <input id="exp-pass" type="password" autocomplete="new-password" @bind="_exportPass" @bind:event="oninput" />
        </div>
        <div class="field">
            <label for="exp-pass2">Repeat passphrase</label>
            <input id="exp-pass2" type="password" autocomplete="new-password" @bind="_exportPass2" @bind:event="oninput" />
        </div>
        <button class="btn primary" @onclick="ExportAsync" disabled="@_busy">Export profiles</button>
        @if (_exportMessage is not null)
        {
            <p class="@(_exportOk ? "success" : "error")">@_exportMessage</p>
        }
    </section>

    <section class="card">
        <h2>Import</h2>
        <div class="field">
            <InputFile OnChange="OnFile" accept=".yanmtcred,application/octet-stream" />
        </div>
        <div class="field">
            <label for="imp-pass">Passphrase</label>
            <input id="imp-pass" type="password" autocomplete="off" @bind="_importPass" @bind:event="oninput" />
        </div>
        <div class="field">
            <label>If a profile name already exists</label>
            <select @bind="_conflict">
                <option value="@ImportConflict.Skip">Keep the existing profile</option>
                <option value="@ImportConflict.Overwrite">Overwrite it (same type only)</option>
            </select>
        </div>
        <button class="btn primary" @onclick="ImportAsync" disabled="@(_busy || _file is null)">Import profiles</button>
        @if (_importError is not null)
        {
            <p class="error">@_importError</p>
        }

        @if (_result is { Ok: true })
        {
            <p class="success">Imported: @_result.Created created, @_result.Updated updated, @_result.Skipped.Count skipped, @_result.Rejected.Count rejected.</p>
            @foreach (var line in _result.Skipped.Concat(_result.Rejected))
            {
                <div class="muted">@line</div>
            }
        }
    </section>
</div>

@code {
    private string _exportPass = "";
    private string _exportPass2 = "";
    private string _importPass = "";
    private ImportConflict _conflict = ImportConflict.Skip;
    private IBrowserFile? _file;
    private string? _exportMessage;
    private bool _exportOk;
    private string? _importError;
    private CredentialImportResult? _result;
    private bool _busy;

    private void OnFile(InputFileChangeEventArgs e)
    {
        _file = e.File;
        _importError = null;
        _result = null;
    }

    private async Task<System.Security.Claims.ClaimsPrincipal> UserAsync() => (await Auth.GetAuthenticationStateAsync()).User;

    private async Task ExportAsync()
    {
        _exportMessage = null;
        if (PassphraseCrypto.ValidatePassphrase(_exportPass) is { } weak)
        {
            _exportOk = false;
            _exportMessage = weak;
            return;
        }

        if (_exportPass != _exportPass2)
        {
            _exportOk = false;
            _exportMessage = "The passphrases don't match.";
            return;
        }

        _busy = true;
        try
        {
            var export = await Transfer.ExportAsync(await UserAsync(), _exportPass);
            using var stream = new MemoryStream(export.File);
            using var reference = new DotNetStreamReference(stream);
            await Js.InvokeVoidAsync("yanmtDownload", $"yanmt-credentials-{Clock.GetUtcNow():yyyyMMdd-HHmm}.yanmtcred", reference);
            _exportOk = true;
            _exportMessage = $"Exported {export.ProfileCount} profile(s)."
                + (export.Unreadable.Count > 0 ? $" Not exported (can't be decrypted on this server): {string.Join(", ", export.Unreadable)}." : "");
            _exportPass = _exportPass2 = "";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportAsync()
    {
        _importError = null;
        _result = null;
        _busy = true;
        try
        {
            byte[] bytes;
            try
            {
                await using var stream = _file!.OpenReadStream(PassphraseCrypto.MaxFileBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                bytes = buffer.ToArray();
            }
            catch (IOException)
            {
                _importError = "The file is too large to be a credential export.";
                return;
            }

            _result = await Transfer.ImportAsync(await UserAsync(), bytes, _importPass, _conflict);
            if (!_result.Ok)
            {
                _importError = _result.Error;
            }

            _importPass = "";
        }
        finally
        {
            _busy = false;
        }
    }
}
