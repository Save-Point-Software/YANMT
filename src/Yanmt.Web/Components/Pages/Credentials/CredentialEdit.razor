@page "/credentials/new"
@page "/credentials/{Id:int}"
@attribute [Authorize(Policy = YanmtPolicies.Admin)]
@inject CredentialService Credentials
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add credential profile" : $"Edit {_originalName}") - YANMT</PageTitle>

<div class="page narrow">
    <p><a href="credentials">← Credentials</a></p>
    <h1>@(IsNew ? "Add credential profile" : $"Edit {_originalName}")</h1>

    @if (_notFound)
    {
        <p class="error">Profile @Id does not exist (it may have been deleted).</p>
    }
    else if (_model is not null && _editContext is not null)
    {
        @if (!_model.StoredSecretsReadable)
        {
            <p class="error">
                The stored password(s) for this profile can't be decrypted on this server (the database was
                probably restored from another machine). Enter them again to fix it.
            </p>
        }

        <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync" FormName="credential-edit">
            <DataAnnotationsValidator />

            <div class="field-row">
                <div class="field">
                    <label for="name">Name</label>
                    <InputText id="name" @bind-Value="_model.Name" autocomplete="off" placeholder="lab-snmpv3" />
                    <ValidationMessage For="() => _model.Name" />
                </div>

                <div class="field">
                    <label for="kind">Type</label>
                    <InputSelect id="kind" @bind-Value="_model.Kind" @bind-Value:after="KindChanged" disabled="@(!IsNew)">
                        <option value="@CredentialKind.SnmpV3">SNMPv3 (authPriv)</option>
                        <option value="@CredentialKind.Ssh">SSH</option>
                    </InputSelect>
                    <ValidationMessage For="() => _model.Kind" />
                </div>
            </div>

            <div class="field-row">
                <div class="field">
                    <label for="username">@(_model.Kind == CredentialKind.Ssh ? "Username" : "SNMPv3 user")</label>
                    <InputText id="username" class="mono" @bind-Value="_model.Username" autocomplete="off" />
                    <ValidationMessage For="() => _model.Username" />
                </div>

                <div class="field narrow-field">
                    <label for="port">@(_model.Kind == CredentialKind.Ssh ? "TCP port" : "UDP port")</label>
                    <InputNumber id="port" @bind-Value="_model.Port" />
                    <ValidationMessage For="() => _model.Port" />
                </div>
            </div>

            @if (_model.Kind == CredentialKind.Ssh)
            {
                <div class="field">
                    <label for="password">Password</label>
                    <InputText id="password" type="password" @bind-Value="_model.Password" autocomplete="new-password"
                               placeholder="@SecretPlaceholder" />
                    <div class="hint">For a local privilege-15 user on the device. No enable secret is used.</div>
                    <ValidationMessage For="() => _model.Password" />
                </div>
            }
            else
            {
                <div class="field-row">
                    <div class="field">
                        <label for="auth">Authentication</label>
                        <InputSelect id="auth" @bind-Value="_model.SnmpAuth" @bind-Value:after="AuthChanged">
                            @foreach (var a in Enum.GetValues<SnmpAuthProtocol>())
                            {
                                <option value="@a">@CredentialRules.Label(a)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="field">
                        <label for="authpw">Auth password</label>
                        <InputText id="authpw" type="password" @bind-Value="_model.AuthPassword" autocomplete="new-password"
                                   placeholder="@SecretPlaceholder" />
                        <ValidationMessage For="() => _model.AuthPassword" />
                    </div>
                </div>

                <div class="field-row">
                    <div class="field">
                        <label for="priv">Privacy</label>
                        <InputSelect id="priv" @bind-Value="_model.SnmpPriv">
                            @foreach (var p in Enum.GetValues<SnmpPrivProtocol>())
                            {
                                <option value="@p" disabled="@(CredentialRules.ValidateSnmpProtocols(_model.SnmpAuth, p) is not null)">@CredentialRules.Label(p)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _model.SnmpPriv" />
                    </div>
                    <div class="field">
                        <label for="privpw">Privacy password</label>
                        <InputText id="privpw" type="password" @bind-Value="_model.PrivPassword" autocomplete="new-password"
                                   placeholder="@SecretPlaceholder" />
                        <ValidationMessage For="() => _model.PrivPassword" />
                    </div>
                </div>
                <div class="hint">
                    SHA-256/AES-128 is the verified pairing on IOS-XE. AES-192/256 are not verified.
                    SHA-1 is for devices without SHA-2 and pairs with AES-128 only.
                </div>
            }

            @if (_error is not null)
            {
                <p class="error">@_error</p>
            }

            <div class="form-actions">
                <button type="submit" class="btn primary" disabled="@_busy">@(IsNew ? "Create" : "Save")</button>
                <a class="btn" href="credentials">Cancel</a>

                @if (!IsNew)
                {
                    <span class="spacer"></span>
                    @if (_confirmDelete)
                    {
                        <span>Delete @_originalName?</span>
                        <button type="button" class="btn danger" @onclick="DeleteAsync" disabled="@_busy">Yes, delete</button>
                        <button type="button" class="btn" @onclick="() => _confirmDelete = false">Keep</button>
                    }
                    else
                    {
                        <button type="button" class="btn danger-outline" @onclick="() => _confirmDelete = true">Delete…</button>
                    }
                }
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private CredentialEditModel? _model;
    private EditContext? _editContext;
    private ValidationMessageStore? _serverErrors;
    private string? _originalName;
    private string? _error;
    private bool _notFound;
    private bool _busy;
    private bool _confirmDelete;

    private bool IsNew => Id is null;

    private string SecretPlaceholder => _model is { SecretsRequired: false } ? "(unchanged; type to replace)" : "";

    protected override async Task OnParametersSetAsync()
    {
        _model = IsNew ? new CredentialEditModel() : await Credentials.GetForEditAsync(Id!.Value);
        _notFound = _model is null;
        _originalName = _model?.Name;

        if (_model is not null)
        {
            _editContext = new EditContext(_model);
            _serverErrors = new ValidationMessageStore(_editContext);
            _editContext.OnFieldChanged += (_, e) => _serverErrors.Clear(e.FieldIdentifier);
        }
    }

    private void KindChanged()
    {
        if (IsNew && _model is not null)
        {
            _model.Port = CredentialRules.DefaultPort(_model.Kind);
            _model.ClearSecrets();
        }
    }

    private void AuthChanged()
    {
        if (_model is not null && CredentialRules.ValidateSnmpProtocols(_model.SnmpAuth, _model.SnmpPriv) is not null)
        {
            _model.SnmpPriv = SnmpPrivProtocol.Aes128;
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = IsNew ? await Credentials.CreateAsync(_model!) : await Credentials.UpdateAsync(Id!.Value, _model!);
            if (result.Ok)
            {
                Nav.NavigateTo("credentials");
                return;
            }

            if (result.Field is not null)
            {
                _serverErrors!.Add(_editContext!.Field(result.Field), result.Error!);
                _editContext.NotifyValidationStateChanged();
            }
            else
            {
                _error = result.Error;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        var result = await Credentials.DeleteAsync(Id!.Value);
        if (result.Ok)
        {
            Nav.NavigateTo("credentials");
            return;
        }

        _busy = false;
        _confirmDelete = false;
        var shown = string.Join(", ", result.UsedBy.Take(10)) + (result.UsedBy.Count > 10 ? $" and {result.UsedBy.Count - 10} more" : "");
        _error = $"This profile is assigned to {result.UsedBy.Count} node(s): {shown}. Unassign it first.";
    }
}
