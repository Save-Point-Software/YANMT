@page "/credentials"
@attribute [Authorize(Policy = YanmtPolicies.Admin)]
@inject CredentialService Credentials

<PageTitle>Credentials - YANMT</PageTitle>

<div class="page-header">
    <h1>Credential profiles</h1>
    <div class="actions">
        <a class="btn primary" href="credentials/new">Add profile</a>
    </div>
</div>

<p class="muted">
    Reusable SSH and SNMPv3 credentials, encrypted with DPAPI on this server. Passwords can be replaced
    but are never shown again after saving. Assign profiles to nodes on the node's edit page or with the
    <code>snmp_profile</code> / <code>ssh_profile</code> CSV columns.
</p>

@if (_profiles is null)
{
    <p class="muted">Loading…</p>
}
else if (_profiles.Count == 0)
{
    <div class="empty">
        <p>No credential profiles yet.</p>
        <p class="muted">Add an SNMPv3 profile (SHA-2 auth, AES privacy) and an SSH profile for the privilege-15 YANMT user.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="grid">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Username</th>
                    <th>Nodes</th>
                    <th>Updated (UTC)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _profiles)
                {
                    <tr @key="p.Id">
                        <td><a href="credentials/@p.Id">@p.Name</a></td>
                        <td>@p.Description</td>
                        <td class="mono">@p.Username</td>
                        <td>@p.NodeCount</td>
                        <td class="nowrap">@p.UpdatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CredentialListItem>? _profiles;

    protected override async Task OnInitializedAsync() => _profiles = await Credentials.ListAsync();
}
