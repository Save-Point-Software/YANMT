@page "/nodes/{Id:int}/view"
@using Yanmt.Core.Monitoring
@using Yanmt.Infrastructure.Data.Entities
@using Yanmt.Infrastructure.Monitoring
@implements IDisposable
@inject NodeService Nodes
@inject NodeDetailService Detail
@inject StatusCache Status
@inject StatusBroadcaster Broadcaster
@inject SettingsService Settings
@inject NavigationManager Nav

<PageTitle>@(_node?.Hostname ?? "Node") - YANMT</PageTitle>

<div class="page">
    <p><a href="">← Map</a> · <a href="nodes">Nodes</a></p>

    @if (_notFound)
    {
        <p class="error">Node @Id does not exist (it may have been deleted).</p>
    }
    else if (_node is not null)
    {
        var live = Status.Get(_node.Id);
        var state = live?.State ?? _node.State;
        <div class="page-header">
            <h1><StateDot State="state" Colors="_colors" /> @_node.Hostname</h1>
            <AuthorizeView Policy="@YanmtPolicies.Admin">
                <div class="actions"><a class="btn" href="nodes/@_node.Id">Edit node</a></div>
            </AuthorizeView>
        </div>

        <div class="node-header">
            <dl class="details">
                <dt>State</dt>
                <dd>@(_node.Enabled ? state.ToString() : "Unknown (node disabled)")</dd>
                <dt>Management IP</dt>
                <dd class="mono">@_node.ManagementIp</dd>
                @if (live?.Source(StatusSourceType.Uptime) is { } up)
                {
                    <dt>Uptime</dt>
                    <dd>@up.ValueText @if (_system?.LastRebootUtc is { } reboot) { <span class="muted">(reboot seen @reboot.ToString("yyyy-MM-dd HH:mm") UTC)</span> }</dd>
                }
                @if (!string.IsNullOrEmpty(_node.Site))
                {
                    <dt>Site</dt>
                    <dd>@_node.Site</dd>
                }
                @if (_node.Tags.Count > 0)
                {
                    <dt>Tags</dt>
                    <dd>@foreach (var t in _node.Tags) { <span class="pill">@t</span> }</dd>
                }
            </dl>
            @if (_system is not null)
            {
                <dl class="details">
                    @if (_system.SysName is { Length: > 0 })
                    {
                        <dt>sysName</dt>
                        <dd>@_system.SysName</dd>
                    }
                    @if (_system.SysLocation is { Length: > 0 })
                    {
                        <dt>Location</dt>
                        <dd>@_system.SysLocation</dd>
                    }
                    @if (_system.SysContact is { Length: > 0 })
                    {
                        <dt>Contact</dt>
                        <dd>@_system.SysContact</dd>
                    }
                    <dt>Last SNMP poll</dt>
                    <dd>
                        @(_system.LastSuccessUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "never") UTC
                        @if (_system.LastPollUtc is { } lp && lp != _system.LastSuccessUtc)
                        {
                            <span class="error">(last attempt @lp.ToString("HH:mm:ss") failed)</span>
                        }
                    </dd>
                </dl>
            }
        </div>
        @if (_system?.SysDescr is { Length: > 0 } descr)
        {
            <details class="sysdescr">
                <summary>@FirstLine(descr)</summary>
                <pre class="output">@descr</pre>
                @if (_system.SysObjectId is { Length: > 0 })
                {
                    <div class="muted mono">sysObjectID @_system.SysObjectId · engine @_system.EngineId · boots @_system.EngineBoots</div>
                }
            </details>
        }

        <nav class="tabs" role="tablist">
            @foreach (var (tab, label) in Tabs)
            {
                <a role="tab" class="@(CurrentTab == tab ? "active" : null)" aria-selected="@(CurrentTab == tab)" href="nodes/@Id/view?tab=@tab">@label</a>
            }
        </nav>

        @switch (CurrentTab)
        {
            case "interfaces":
                <NodeInterfacesTab NodeId="Id" SnmpReady="SnmpReady" />
                break;
            case "query":
                <NodeQueryTab NodeId="Id" SnmpReady="SnmpReady" />
                break;
            case "events":
                <section class="card">
                    <h2>Recent events</h2>
                    @if (_events.Count == 0)
                    {
                        <p class="muted">No state changes recorded.</p>
                    }
                    else
                    {
                        <table class="grid">
                            <thead><tr><th>Time (UTC)</th><th class="col-state"></th><th>Event</th></tr></thead>
                            <tbody>
                                @foreach (var e in _events)
                                {
                                    <tr>
                                        <td class="mono nowrap">@e.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td class="col-state"><StateDot State="e.NewState" Colors="_colors" /></td>
                                        <td>@e.Message</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <p class="muted">The full event log (filters, acknowledgement, export) arrives in Phase 6.</p>
                </section>
                break;
            case "backups":
                <section class="card">
                    <h2>Config backups</h2>
                    <p class="muted">Scheduled <code>show running-config</code> backups with history and diffs arrive in Phase 5.</p>
                </section>
                break;
            default:
                <NodeOverviewTab NodeId="Id" Node="_node" Live="live" Colors="_colors" Version="_version" />
                break;
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private static readonly (string Tab, string Label)[] Tabs =
    [
        ("overview", "Overview"), ("interfaces", "Interfaces"), ("query", "SNMP query"), ("events", "Events"), ("backups", "Config backups"),
    ];

    private NodeListItem? _node;
    private NodeSystemView? _system;
    private List<NodeEventItem> _events = [];
    private StatusColors _colors = StatusColors.Default;
    private bool _notFound;

    /// <summary>Bumped on each live update so the overview reloads its charts.</summary>
    private int _version;

    private string CurrentTab => Tabs.Any(t => t.Tab == Tab) ? Tab! : "overview";

    private bool SnmpReady => _node is { Enabled: true, SnmpEnabled: true } && _hasSnmpProfile;

    private bool _hasSnmpProfile;

    protected override async Task OnInitializedAsync()
    {
        _colors = await Settings.GetAsync(SettingKeys.StatusColors);
        Broadcaster.Changed += OnStatusChanged;
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _node = await Nodes.GetAsync(Id);
        _notFound = _node is null;
        if (_node is null)
        {
            return;
        }

        _hasSnmpProfile = (await Nodes.GetForEditAsync(Id))?.SnmpProfileId is not null;
        _system = await Detail.GetSystemAsync(Id);
        _events = await Nodes.RecentEventsAsync(Id, 50);
    }

    private void OnStatusChanged(IReadOnlyCollection<int> ids)
    {
        if (ids.Contains(Id))
        {
            _ = InvokeAsync(async () =>
            {
                _system = await Detail.GetSystemAsync(Id);
                _events = await Nodes.RecentEventsAsync(Id, 50);
                _version++;
                StateHasChanged();
            });
        }
    }

    private static string FirstLine(string s)
    {
        var line = s.Split('\n', 2)[0].Trim();
        return line.Length > 160 ? line[..160] + "…" : line;
    }

    public void Dispose() => Broadcaster.Changed -= OnStatusChanged;
}
