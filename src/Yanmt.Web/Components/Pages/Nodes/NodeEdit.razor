@page "/nodes/new"
@page "/nodes/{Id:int}"
@attribute [Authorize(Policy = YanmtPolicies.Admin)]
@using System.Globalization
@using Yanmt.Core.Monitoring
@inject NodeService Nodes
@inject CredentialService Credentials
@inject SettingsService Settings
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add node" : $"Edit {_originalHostname}") - YANMT</PageTitle>

<div class="page narrow">
    <p><a href="nodes">← Nodes</a></p>
    <h1>@(IsNew ? "Add node" : $"Edit {_originalHostname}")</h1>

    @if (_notFound)
    {
        <p class="error">Node @Id does not exist (it may have been deleted).</p>
    }
    else if (_model is not null && _editContext is not null)
    {
        <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync" FormName="node-edit">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="hostname">Hostname</label>
                <InputText id="hostname" @bind-Value="_model.Hostname" autocomplete="off" />
                <ValidationMessage For="() => _model.Hostname" />
            </div>

            <div class="field">
                <label for="ip">Management IP</label>
                <InputText id="ip" class="mono" @bind-Value="_model.ManagementIp" autocomplete="off" placeholder="192.0.2.10" />
                <ValidationMessage For="() => _model.ManagementIp" />
            </div>

            <div class="field-row">
                <div class="field">
                    <label for="site">Site</label>
                    <InputText id="site" @bind-Value="_model.Site" list="sites" />
                    <datalist id="sites">
                        @foreach (var s in _sites)
                        {
                            <option value="@s"></option>
                        }
                    </datalist>
                    <ValidationMessage For="() => _model.Site" />
                </div>

                <div class="field">
                    <label for="icon">Icon</label>
                    <InputSelect id="icon" @bind-Value="_model.Icon">
                        @foreach (var icon in Enum.GetValues<NodeIconType>())
                        {
                            <option value="@icon">@icon</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <div class="field">
                <label for="tags">Tags</label>
                <InputText id="tags" @bind-Value="_model.Tags" placeholder="core; dmvpn-hub; lab" />
                <div class="hint">Separate with ; or ,. Existing: @(_tags.Count == 0 ? "none yet" : string.Join(", ", _tags))</div>
                <ValidationMessage For="() => _model.Tags" />
            </div>

            <fieldset class="checks">
                <legend>Monitoring</legend>
                <label><InputCheckbox @bind-Value="_model.Enabled" /> Enabled (unchecked pauses all polling for this node)</label>
                <label><InputCheckbox @bind-Value="_model.IcmpEnabled" /> ICMP</label>
                <label><InputCheckbox @bind-Value="_model.SnmpEnabled" /> SNMP</label>
                <label><InputCheckbox @bind-Value="_model.SshEnabled" /> SSH (config backups)</label>
            </fieldset>

            <div class="field-row profiles">
                <div class="field">
                    <label for="snmp-profile">SNMPv3 profile</label>
                    <InputSelect id="snmp-profile" @bind-Value="_model.SnmpProfileId">
                        <option value="">(none)</option>
                        @foreach (var p in _snmpProfiles)
                        {
                            <option value="@p.Id">@p.Display</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.SnmpProfileId" />
                </div>
                <div class="field">
                    <label for="ssh-profile">SSH profile</label>
                    <InputSelect id="ssh-profile" @bind-Value="_model.SshProfileId">
                        <option value="">(none)</option>
                        @foreach (var p in _sshProfiles)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.SshProfileId" />
                </div>
            </div>
            @if (_snmpProfiles.Count == 0 || _sshProfiles.Count == 0)
            {
                <div class="hint">Profiles are managed under <a href="credentials">Credentials</a>.</div>
            }

            <fieldset class="thresholds">
                <legend>CPU and memory thresholds (%)</legend>
                <div class="field-row">
                    <div class="field narrow-field">
                        <label for="cpu-warn">CPU Warning</label>
                        <InputNumber id="cpu-warn" @bind-Value="_model.CpuWarningPercent" placeholder="@_snmp.CpuWarningPercent.ToString(CultureInfo.InvariantCulture)" />
                    </div>
                    <div class="field narrow-field">
                        <label for="cpu-crit">CPU Critical</label>
                        <InputNumber id="cpu-crit" @bind-Value="_model.CpuCriticalPercent" placeholder="@_snmp.CpuCriticalPercent.ToString(CultureInfo.InvariantCulture)" />
                    </div>
                    <div class="field narrow-field">
                        <label for="mem-warn">Memory Warning</label>
                        <InputNumber id="mem-warn" @bind-Value="_model.MemoryWarningPercent" placeholder="@_snmp.MemoryWarningPercent.ToString(CultureInfo.InvariantCulture)" />
                    </div>
                    <div class="field narrow-field">
                        <label for="mem-crit">Memory Critical</label>
                        <InputNumber id="mem-crit" @bind-Value="_model.MemoryCriticalPercent" placeholder="@_snmp.MemoryCriticalPercent.ToString(CultureInfo.InvariantCulture)" />
                    </div>
                </div>
                <ValidationMessage For="() => _model.CpuWarningPercent" />
                <ValidationMessage For="() => _model.MemoryWarningPercent" />
                <div class="hint">Blank uses the global value from <a href="settings">Settings</a> (shown greyed). If a node's Warning ends up at or above its Critical, it just goes straight to Critical.</div>
            </fieldset>

            @if (_error is not null)
            {
                <p class="error">@_error</p>
            }

            <div class="form-actions">
                <button type="submit" class="btn primary" disabled="@_busy">@(IsNew ? "Create" : "Save")</button>
                <a class="btn" href="nodes">Cancel</a>

                @if (!IsNew)
                {
                    <span class="spacer"></span>
                    @if (_confirmDelete)
                    {
                        <span>Delete @_originalHostname and its history?</span>
                        <button type="button" class="btn danger" @onclick="DeleteAsync" disabled="@_busy">Yes, delete</button>
                        <button type="button" class="btn" @onclick="() => _confirmDelete = false">Keep</button>
                    }
                    else
                    {
                        <button type="button" class="btn danger-outline" @onclick="() => _confirmDelete = true">Delete…</button>
                    }
                }
            </div>
        </EditForm>

        @if (!IsNew)
        {
            <ConnectionTests NodeId="Id!.Value" UnsavedChanges="_editContext.IsModified()" HostKey="_model.SshHostKey"
                             HostKeyChanged="ReloadHostKeyAsync" />
        }
    }
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private NodeEditModel? _model;
    private EditContext? _editContext;
    private ValidationMessageStore? _serverErrors;
    private List<string> _tags = [];
    private List<string> _sites = [];
    private List<CredentialOption> _snmpProfiles = [];
    private List<CredentialOption> _sshProfiles = [];
    private string? _originalHostname;
    private string? _error;
    private bool _notFound;
    private bool _busy;
    private bool _confirmDelete;

    private bool IsNew => Id is null;

    private SnmpSettings _snmp = new();

    protected override async Task OnParametersSetAsync()
    {
        _snmp = await Settings.GetAsync(SettingKeys.Snmp);
        _tags = await Nodes.AllTagsAsync();
        _sites = await Nodes.AllSitesAsync();
        _snmpProfiles = await Credentials.OptionsAsync(CredentialKind.SnmpV3);
        _sshProfiles = await Credentials.OptionsAsync(CredentialKind.Ssh);
        _model = IsNew ? new NodeEditModel() : await Nodes.GetForEditAsync(Id!.Value);
        _notFound = _model is null;
        _originalHostname = _model?.Hostname;

        if (_model is not null)
        {
            _editContext = new EditContext(_model);
            _serverErrors = new ValidationMessageStore(_editContext);
            _editContext.OnFieldChanged += (_, e) => _serverErrors.Clear(e.FieldIdentifier);
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = IsNew ? await Nodes.CreateAsync(_model!) : await Nodes.UpdateAsync(Id!.Value, _model!);
            if (result.Ok)
            {
                Nav.NavigateTo("nodes");
                return;
            }

            if (result.Field is not null)
            {
                _serverErrors!.Add(_editContext!.Field(result.Field), result.Error!);
                _editContext.NotifyValidationStateChanged();
            }
            else
            {
                _error = result.Error;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadHostKeyAsync()
    {
        var saved = await Nodes.GetForEditAsync(Id!.Value);
        _model!.SshHostKey = saved?.SshHostKey;
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        await Nodes.DeleteAsync(Id!.Value);
        Nav.NavigateTo("nodes");
    }
}
