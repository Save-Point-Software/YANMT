@inherits LayoutComponentBase

<header class="topbar">
    <a class="brand" href="">YANMT</a>
    <nav>
        <NavLink href="" Match="NavLinkMatch.All">Map</NavLink>
        <NavLink href="maps">Maps</NavLink>
        <NavLink href="nodes">Nodes</NavLink>
        <NavLink href="events">Events</NavLink>
        <CriticalEventBadge />
        <NavLink href="monitors">Monitors</NavLink>
        <NavLink href="settings">Settings</NavLink>
        <AuthorizeView Policy="@YanmtPolicies.Admin">
            <NavLink href="credentials">Credentials</NavLink>
            <NavLink href="audit">Audit log</NavLink>
        </AuthorizeView>
    </nav>
    <AuthorizeView>
        <span class="whoami" title="Signed in with Windows authentication">
            @context.User.Identity?.Name
            <span class="role-badge">@(context.User.IsInRole(YanmtRoles.Admin) ? "admin" : "viewer")</span>
        </span>
    </AuthorizeView>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
