<Project>
  <!--
    Central package versions. Every package here was approved in docs/SPEC.md.
    Ask before adding anything new (see CLAUDE.md).
  -->
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <PackageVersion Include="Lextm.SharpSnmpLib" Version="12.5.7" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Dev-time only (not shipped)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Installer (build-only, installer/ only; nothing here ships in yanmt.exe)">
    <!-- The WiX SDK version is in installer/Yanmt.Installer.wixproj (Sdk="WixToolset.Sdk/x.y.z"); keep them equal. -->
    <PackageVersion Include="WixToolset.Util.wixext" Version="7.0.1" />
    <PackageVersion Include="WixToolset.Firewall.wixext" Version="7.0.1" />
    <PackageVersion Include="WixToolset.UI.wixext" Version="7.0.1" />
    <PackageVersion Include="WixToolset.Dtf.CustomAction" Version="7.0.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
